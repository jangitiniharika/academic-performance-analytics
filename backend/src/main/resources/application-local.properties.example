# ==================================================================
# Local overrides - TEMPLATE ONLY (safe to commit).
#
# The real file  application-local.properties  is git-ignored and is
# loaded by Spring Boot only when the "local" profile is active:
#
#   mvn spring-boot:run -Dspring-boot.run.profiles=local
#   java -jar target\academic-performance-platform-*.jar --spring.profiles.active=local
#
# Copy this file to application-local.properties and put your real
# machine-specific values there. NEVER commit that copy.
# ==================================================================

# --- MySQL connection for THIS machine ---
# spring.datasource.url=jdbc:mysql://127.0.0.1:3306/academic_analytics?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
# spring.datasource.username=academic_user
# spring.datasource.password=CHANGE_ME

# --- JWT signing key (at least 32 random characters) ---
# app.jwt.secret=CHANGE_ME_to_a_long_random_value_at_least_32_chars

# --- Demo seeder (set false for a clean / production-like start) ---
# app.seed.enabled=false

# ------------------------------------------------------------------
# Alternatively (recommended) leave this file out entirely and set
# environment variables before starting the backend:
#
#   $env:DB_USERNAME = "academic_user"
#   $env:DB_PASSWORD = "CHANGE_ME"
#   $env:JWT_SECRET  = "a-long-random-value-at-least-32-characters"
#
# application.properties already reads all of these with
# ${ENV_VAR:dev-default} syntax, so no file edit is required.
# ------------------------------------------------------------------
