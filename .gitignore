# Local project MySQL instance (data files + logs - NEVER commit)
.mysql/

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*

# Maven / backend
backend/target/
*.class

# Local secrets / machine specific overrides - NEVER commit these.
