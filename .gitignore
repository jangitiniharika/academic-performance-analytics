.env
.env.*
!*.env.example
**/.env
**/.env.*
!**/.env.example
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-*.properties
!backend/src/main/resources/application.properties
!backend/src/main/resources/application-*.example
*.local
*.secret
*.pem
*.key

# IDE
.idea/
.vscode/
*.iml
.classpath
.project
.settings/

